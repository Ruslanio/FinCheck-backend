# Copy to .env and fill in values — never commit .env

# App JDBC connection (used by ./gradlew run — points at host port)
DB_URL=jdbc:postgresql://localhost:5433/financetracker
DB_USER=financetracker
DB_PASSWORD=changeme_local

# Docker postgres service init credentials (must match DB_USER/DB_PASSWORD)
POSTGRES_DB=financetracker
POSTGRES_USER=financetracker
POSTGRES_PASSWORD=changeme_local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth & integrations
JWT_SECRET=change-me-in-production
LLM_API_KEY=your-llm-api-key-here
